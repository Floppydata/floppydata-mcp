{
  "name": "@floppydata/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Floppydata Client API v2.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floppydata/floppydata-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Floppydata/floppydata-mcp/issues"
  },
  "homepage": "https://github.com/Floppydata/floppydata-mcp#readme",
  "bin": {
    "floppydata-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "keywords": [
    "floppydata",
    "mcp",
    "proxy",
    "web-data"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
